# 📋 Copy to .env.local and fill with REAL values!
# DO NOT COMMIT .env.local!

# 🌐 Domain
MASTODON_DOMAIN=bashraccoon.de

# 🔑 Mastodon Secrets (GENERATE mit: podman run ... bundle exec rake secret)
SECRET_KEY_BASE=your-long-secret-here-min-64-chars
OTP_SECRET=your-otp-secret-min-32-chars
VAPID_PRIVATE_KEY=your-vapid-key
VAPID_PUBLIC_KEY=your-vapid-public-key

# 📧 SMTP (optional)
SMTP_SERVER=smtp.mailtrap.io
SMTP_PORT=2525
SMTP_LOGIN=your-email
SMTP_PASSWORD=your-password
